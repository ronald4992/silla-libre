rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esAdministrador() {
      return autenticado()
        && request.auth.token.admin == true;
    }

    match /usuarios/{usuarioId} {
      allow create: if autenticado()
        && request.auth.uid == usuarioId;

      allow read, update, delete: if autenticado()
        && request.auth.uid == usuarioId;
    }

    match /restaurantes/{restauranteId} {
      allow read: if esAdministrador()
        || (
          autenticado()
          && resource.data.propietario == request.auth.uid
        );

      allow create: if esAdministrador()
        || (
          autenticado()
          && request.resource.data.propietario == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.keys().hasOnly([
            'nombre',
            'direccion',
            'comida',
            'certificado',
            'propietario',
            'correoPropietario',
            'estado',
            'menu',
            'menuPdfUrl',
            'menuPdfNombre',
            'mesasPorTurno',
            'diasNoDisponibles',
            'fechasNoDisponibles',
            'creadoEn'
          ])
          && request.resource.data.keys().hasAll([
            'nombre',
            'direccion',
            'comida',
            'certificado',
            'propietario',
            'correoPropietario',
            'estado',
            'menu',
            'menuPdfUrl',
            'menuPdfNombre',
            'mesasPorTurno',
            'diasNoDisponibles',
            'fechasNoDisponibles',
            'creadoEn'
          ])
          && request.resource.data.nombre is string
          && request.resource.data.direccion is string
          && request.resource.data.comida is string
          && request.resource.data.certificado is string
          && request.resource.data.correoPropietario is string
          && request.resource.data.menu is list
          && request.resource.data.menuPdfUrl is string
          && request.resource.data.menuPdfNombre is string
          && request.resource.data.mesasPorTurno is int
          && request.resource.data.diasNoDisponibles is list
          && request.resource.data.fechasNoDisponibles is list
          && request.resource.data.creadoEn is timestamp
        );

      allow delete: if esAdministrador()
        || (
          autenticado()
          && resource.data.propietario == request.auth.uid
        );

      allow update: if esAdministrador()
        || (
          autenticado()
          && resource.data.propietario == request.auth.uid
          && (
            resource.data.estado == 'aprobado'
            || !resource.data.keys().hasAny(['estado'])
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'menu',
              'menuPdfUrl',
              'menuPdfNombre',
              'mesasPorTurno',
              'diasNoDisponibles',
              'fechasNoDisponibles'
            ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['menu'])
            || request.resource.data.menu is list
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['menuPdfUrl'])
            || request.resource.data.menuPdfUrl is string
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['menuPdfNombre'])
            || request.resource.data.menuPdfNombre is string
          )
        );
    }

    match /restaurantesPublicos/{restauranteId} {
      allow read: if true;

      allow create: if esAdministrador();

      allow delete: if esAdministrador()
        || (
          autenticado()
          && resource.data.propietario == request.auth.uid
        );

      allow update: if autenticado()
        && exists(
          /databases/$(database)/documents/restaurantes/$(restauranteId)
        )
        && get(
          /databases/$(database)/documents/restaurantes/$(restauranteId)
        ).data.propietario == request.auth.uid
        && (
          get(
            /databases/$(database)/documents/restaurantes/$(restauranteId)
          ).data.estado == 'aprobado'
          || !get(
            /databases/$(database)/documents/restaurantes/$(restauranteId)
          ).data.keys().hasAny(['estado'])
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'mesasPorTurno',
            'diasNoDisponibles',
            'fechasNoDisponibles'
          ])
        && request.resource.data.mesasPorTurno is int
        && request.resource.data.diasNoDisponibles is list
        && request.resource.data.fechasNoDisponibles is list;
    }

    match /reservas/{reservaId} {
      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid;

      allow read, delete: if autenticado()
        && resource.data.usuarioId == request.auth.uid;

      allow update: if autenticado()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid;
    }

    match /resenas/{resenaId} {
      allow read: if true;

      allow create: if autenticado()
        && request.resource.data.keys().hasOnly([
          'restauranteId',
          'restaurante',
          'usuarioId',
          'autor',
          'calificacion',
          'comentario',
          'creadoEn'
        ])
        && request.resource.data.keys().hasAll([
          'restauranteId',
          'restaurante',
          'usuarioId',
          'autor',
          'calificacion',
          'comentario',
          'creadoEn'
        ])
        && request.resource.data.usuarioId == request.auth.uid
        && (request.resource.data.restauranteId is int
          || request.resource.data.restauranteId is string)
        && request.resource.data.restaurante is string
        && request.resource.data.autor is string
        && request.resource.data.calificacion is int
        && request.resource.data.calificacion >= 1
        && request.resource.data.calificacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 1000
        && request.resource.data.creadoEn is timestamp;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
